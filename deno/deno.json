{
  "name": "@langtest/deno-baseline",
  "version": "1.0.0",
  "exports": "./src/main.ts",
  "tasks": {
    "start": "deno run --allow-read src/main.ts",
    "test": "deno test --allow-read",
    "check": "deno check src/main.ts test/",
    "lint": "deno lint",
    "fmt": "deno fmt"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19"
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "fmt": {
    "lineWidth": 100
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  }
}
